{
  "manifest_version": 3,
  "name": "TajerTrack Companion",
  "short_name": "TajerTrack",
  "description": "Captures customer details from authorized Guepex parcel-creation requests and securely links them to TajerTrack.",
  "version": "1.1.0",
  "key": "",
  "permissions": ["storage", "webRequest"],
  "host_permissions": [
    "https://api.guepex.app/*",
    "https://*.guepex.app/*",
    "https://api.yalidine.app/*",
    "https://*.yalidine.app/*",
    "https://tajertrack.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://tajertrack.vercel.app/*",
      "http://localhost:3000/*"
    ]
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
