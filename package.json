{
  "name": "my-saas-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm --filter web dev",
    "dev:telegram-worker": "pnpm --filter telegram-worker dev",
    "dev:push-worker": "pnpm --filter push-worker dev",
    "lint": "turbo lint",
    "start:push-worker": "node apps/push-worker/dist/main.js",
    "start:telegram-worker": "node apps/telegram-worker/dist/main.js",
    "seo:indexnow": "node tools/seo/submit-indexnow.mjs",
    "seo:check": "node tools/seo/check-public-discovery.mjs",
    "seo:benchmark": "node tools/seo/benchmark.mjs run",
    "seo:benchmark:import": "node tools/seo/benchmark.mjs import",
    "seo:benchmark:report": "node tools/seo/benchmark.mjs report",
    "seo:benchmark:test": "node tools/seo/benchmark.mjs test"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
